<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Surveys"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select an Event or Service"
        android:textSize="16sp"
        android:padding="8dp" />

    <ListView
        android:id="@+id/surveyEventsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/selectedEventTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No event selected"
        android:textStyle="bold"
        android:padding="8dp" />

    <EditText
        android:id="@+id/questionEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter a rating question"
        android:inputType="textMultiLine"
        android:minLines="2" />

    <Button
        android:id="@+id/saveSurveyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Survey" />

</LinearLayout>